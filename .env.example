# The app entry point
FLASK_APP=wsgi

# 1 turns on the debugger in development; keep 0 anywhere else
FLASK_DEBUG=0

# production (default), development or testing
APP_ENV=production

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# IANA timezone that defines "today" and "this month"; change it if needed
APP_TIMEZONE=America/Toronto