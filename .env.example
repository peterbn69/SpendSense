# The app entry point
FLASK_APP=wsgi

# 1 turns on the debugger in development; keep 0 anywhere else
FLASK_DEBUG=0

# production (default), development or testing
APP_ENV=production

# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# IANA timezone that defines "today" and "this month"; change it if needed
APP_TIMEZONE=America/Toronto

# Required. Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME (URL-encode special characters in the password)
DATABASE_URL=

# Optional: DEBUG, INFO (default), WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Used by pytest only. A separate, disposable database: tests drop and recreate its tables.
TEST_DATABASE_URL=